{
  "name": "huebar",
  "displayName": "HueBar",
  "description": "Automatically colorize VS Code title bars for visual distinction in macOS Mission Control",
  "version": "0.1.1",
  "publisher": "achitjain",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "titlebar",
    "color",
    "macos",
    "mission control",
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "huebar.setColor",
        "title": "Set Title Bar Color",
        "category": "HueBar"
      },
      {
        "command": "huebar.resetColor",
        "title": "Reset Title Bar Color",
        "category": "HueBar"
      }
    ],
    "configuration": {
      "title": "HueBar",
      "properties": {
        "huebar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable HueBar title bar colorization."
        },
        "huebar.scope": {
          "type": "string",
          "enum": [
            "workspace",
            "user"
          ],
          "enumDescriptions": [
            "Write color customizations to workspace settings (.vscode/settings.json)",
            "Write color customizations to global user settings"
          ],
          "default": "workspace",
          "description": "Where to write workbench color customizations."
        },
        "huebar.colorStatusBar": {
          "type": "boolean",
          "default": false,
          "description": "Also apply the workspace color to the status bar."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.19.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^5.3.0"
  }
}
